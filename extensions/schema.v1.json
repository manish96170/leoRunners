{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leorunners.invalid/schemas/extensions.v1.json",
  "title": "Leo Runners extension metadata and advisory envelope v1",
  "description": "Optional, bounded, redacted output from observational extensions. Consumers must not treat it as lifecycle authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "extensionId", "extensionType", "emittedAt", "subject", "retention", "metadata", "advisory"],
  "properties": {
    "apiVersion": {"const": "extensions.leorunners.io/v1"},
    "kind": {"const": "ExtensionRecord"},
    "extensionId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
    "extensionType": {"enum": ["analytics", "cache", "security", "intelligence"]},
    "emittedAt": {"type": "string", "format": "date-time"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "jobId"],
      "properties": {
        "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
        "jobId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
        "runnerId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
        "repository": {"type": "string", "maxLength": 255}
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["expiresAt", "redacted", "evidenceClass"],
      "properties": {
        "expiresAt": {"type": "string", "format": "date-time"},
        "redacted": {"const": true},
        "evidenceClass": {"enum": ["metadata", "operational", "diagnostic"]}
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "eventType", "source", "evidence", "values"],
      "properties": {
        "schemaVersion": {"const": "1"},
        "eventType": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
        "source": {"type": "string", "minLength": 1, "maxLength": 128},
        "evidence": {"enum": ["observed", "derived", "synthetic"]},
        "values": {
          "type": "object", "maxProperties": 24,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
          "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
        }
      }
    },
    "advisory": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "severity", "summary", "confidence", "recommendations", "annotations"],
      "properties": {
        "status": {"enum": ["none", "informational", "review", "blocked"]},
        "severity": {"enum": ["none", "low", "medium", "high"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "recommendations": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "annotations": {
          "type": "object", "maxProperties": 16,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
          "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
        }
      }
    }
  }
}
