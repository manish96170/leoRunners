{
  "apiVersion": "events.leorunners.io/v1",
  "kind": "EventSinkContract",
  "metadata": {"name": "unsafe-events", "version": "1.0.0"},
  "spec": {
    "enabled": true,
    "transport": "https",
    "delivery": {"ack_mode": "before_persist", "idempotency_key": "eventId", "max_attempts": 0, "retry_backoff_seconds": 0, "queue_capacity": 0, "overflow": "block", "dead_letter": {"enabled": false, "max_items": 0}},
    "archive": {"path": "relative/events.jsonl", "file_mode": "0644", "owner_only": false, "restart_behavior": "truncate", "max_line_bytes": 0, "max_bytes": 0, "max_files": 0, "max_age_seconds": 0},
    "redaction": {"required": false, "mode": "raw", "max_bytes": 0, "forbidden_fields": []},
    "replay": {"enabled": true, "max_events": 0, "max_window_seconds": 0, "preserve_event_id": false, "side_effects": "allowed", "mode": "write"}
  }
}
