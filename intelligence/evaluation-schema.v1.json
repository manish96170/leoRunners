{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leorunners.invalid/schemas/intelligence-evaluation.v1.json",
  "title": "LeoRunners telemetry-backed intelligence evaluation",
  "type": "object",
  "required": ["version", "dataset_id", "provenance", "ai_enabled", "policy_version", "telemetry", "cases"],
  "properties": {
    "version": {"const": "intelligence-evaluation.v1"},
    "dataset_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provenance": {"enum": ["synthetic", "real"]},
    "ai_enabled": {"const": false},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "telemetry": {"type": "array", "minItems": 1, "maxItems": 10000},
    "cases": {"type": "array", "minItems": 1, "maxItems": 1000}
  },
  "additionalProperties": false
}
