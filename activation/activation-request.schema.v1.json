{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leo-runners.dev/schemas/activation-request.v1.json",
  "title": "Leo Runners activation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "activation.leorunners.io/v1" },
    "kind": { "const": "ActivationRequest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id", "requested_at", "operator", "approver", "target",
        "scope_file", "scopes", "resource_prefix", "max_resources", "deadline",
        "budget", "notification", "rollback_owner", "mode"
      ],
      "properties": {
        "request_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
        "requested_at": { "type": "string", "format": "date-time" },
        "operator": { "$ref": "#/$defs/owner" },
        "approver": { "$ref": "#/$defs/owner" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "account", "project", "region", "repository"],
          "properties": {
            "provider": { "enum": ["aws", "gcp", "github"] },
            "account": { "type": ["string", "null"], "maxLength": 128 },
            "project": { "type": ["string", "null"], "maxLength": 128 },
            "region": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" },
            "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" }
          }
        },
        "scope_file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "pattern": "^[A-Za-z0-9_.-][A-Za-z0-9_./-]{0,255}$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "resource_prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$" },
        "max_resources": { "type": "integer", "minimum": 1, "maximum": 100 },
        "deadline": { "type": "string", "format": "date-time" },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "max_amount"],
          "properties": {
            "currency": { "const": "USD" },
            "max_amount": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }
          }
        },
        "notification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "destination"],
          "properties": {
            "channel": { "enum": ["email", "slack", "pagerduty"] },
            "destination": { "type": "string", "pattern": "^[^\\s]{1,256}$" }
          }
        },
        "rollback_owner": { "$ref": "#/$defs/owner" },
        "mode": { "enum": ["read-only", "connectivity", "lifecycle"] },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approved_at", "phrase", "change_reference"],
          "properties": {
            "approved_at": { "type": "string", "format": "date-time" },
            "phrase": { "const": "I_UNDERSTAND_EPHEMERAL_RESOURCES" },
            "change_reference": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,127}$" }
          }
        }
      }
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contact"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{1,63}$" },
        "contact": { "type": "string", "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" }
      }
    }
  }
}
