# Copy to ~/.leo-runners-rehearsal/github.env and fill in. None of these is a
# secret. The App private key goes in through store-app-key.sh, not here.

# Shown on the GitHub App's settings page ("App ID", or the Client ID).
GITHUB_APP_ID=
# The installation of the App on your test org or repo (see README).
GITHUB_APP_INSTALLATION_ID=
# Numeric ID of the runner group the runners register to.
GITHUB_RUNNER_GROUP_ID=

# Where runners register: repository (default; needs the App's repository
# Administration: write) or organization (needs only the organization
# Self-hosted runners permission; the group must be an organization runner group).
# GITHUB_RUNNER_SCOPE=organization

# Allow exactly one of these. Use the narrowest scope that works.
GITHUB_ALLOWED_ORGANIZATIONS=
GITHUB_ALLOWED_REPOSITORIES=

# Optional: ask GitHub for tokens narrower than the App's grant.
# GITHUB_APP_TOKEN_PERMISSIONS=administration=write

# Optional: labels a job must use. Defaults to self-hosted,linux,<your arch>.
# LEO_RUNNER_LABELS=self-hosted,linux,arm64
