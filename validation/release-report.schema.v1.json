{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.leorunners.io/release-validation.v1.json",
  "title": "Leo Runners release validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "release-validation.leorunners.io/v1"},
    "kind": {"const": "ReleaseValidationReport"},
    "metadata": {"type": "object", "required": ["name", "version"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "version": {"type": "string"}}},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "read_only", "live_provisioning_invoked", "checks", "summary"],
      "properties": {
        "status": {"enum": ["pass", "warn", "fail"]},
        "read_only": {"const": true},
        "live_provisioning_invoked": {"const": false},
        "checks": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "status", "exit_code", "message"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"}, "status": {"enum": ["PASS", "WARN", "FAIL"]}, "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}, "message": {"type": "string", "maxLength": 512}}}},
        "summary": {"type": "object", "additionalProperties": false, "required": ["warnings", "failures"], "properties": {"warnings": {"type": "integer", "minimum": 0}, "failures": {"type": "integer", "minimum": 0}}}
      }
    }
  }
}
