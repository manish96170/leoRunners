{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.leorunners.io/final-audit-report.v1.json",
  "title": "Leo Runners final architecture and production-readiness audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "final-audit.leorunners.io/v1"},
    "kind": {"const": "FinalAuditReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "leo-runners-final-audit"},
        "version": {"const": "1.0.0"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "read_only", "live_mutation_invoked", "redaction", "checks", "environment_gaps", "summary"],
      "properties": {
        "status": {"enum": ["PASS", "WARN", "BLOCKED"]},
        "read_only": {"const": true},
        "live_mutation_invoked": {"const": false},
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "raw_output_included", "secrets_scanned"],
          "properties": {
            "status": {"const": "redacted"},
            "raw_output_included": {"const": false},
            "secrets_scanned": {"const": true}
          }
        },
        "checks": {"type": "array", "minItems": 6, "maxItems": 32, "items": {"$ref": "#/$defs/check"}},
        "environment_gaps": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/gap"}},
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "warnings", "blocked"],
          "properties": {
            "pass": {"type": "integer", "minimum": 0},
            "warnings": {"type": "integer", "minimum": 0},
            "blocked": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "exit_code", "message", "environment_gated"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "status": {"enum": ["PASS", "WARN", "BLOCKED"]},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "message": {"type": "string", "maxLength": 512},
        "environment_gated": {"type": "boolean"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "status": {"const": "environment-gated"},
        "message": {"type": "string", "maxLength": 240}
      }
    }
  }
}
