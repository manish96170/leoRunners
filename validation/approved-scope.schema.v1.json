{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leo-runners.dev/schemas/approved-validation-scope.v1.json",
  "title": "Leo Runners approved validation scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "validation.leorunners.io/v1" },
    "kind": { "const": "ApprovedValidationScope" },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "region", "project", "repository", "resource_prefix", "max_resources", "deadline", "ownership"],
      "properties": {
        "provider": { "enum": ["aws", "gcp"] },
        "region": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$" },
        "project": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,127}$" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
        "resource_prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
        "max_resources": { "type": "integer", "minimum": 1, "maximum": 100 },
        "deadline": { "type": "string", "format": "date-time" },
        "ownership": {
          "type": "object", "additionalProperties": false,
          "required": ["notification", "rollback"],
          "properties": {
            "notification": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/@:+-]{2,127}$" },
            "rollback": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/@:+-]{2,127}$" }
          }
        }
      }
    }
  }
}
