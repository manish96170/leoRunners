{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leo-runners.dev/schemas/preflight-evidence.v1.json",
  "title": "Leo Runners offline preflight evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "validation.leorunners.io/v1" },
    "kind": { "const": "PreflightEvidence" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } } },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["run", "provider", "observability", "cleanup"],
      "properties": {
        "run": { "type": "object", "additionalProperties": false, "required": ["run_id", "mode", "started_at", "finished_at", "duration_ms", "outcome"], "properties": { "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" }, "mode": { "const": "read_only_preflight" }, "started_at": { "type": "string", "format": "date-time" }, "finished_at": { "type": "string", "format": "date-time" }, "duration_ms": { "type": "integer", "minimum": 0, "maximum": 3600000 }, "outcome": { "enum": ["passed", "aborted", "failed"] }, "outcome_reason": { "type": "string", "minLength": 1, "maxLength": 512 } } },
        "provider": { "type": "object", "additionalProperties": false, "required": ["name", "region", "account_scope", "resource_scope"], "properties": { "name": { "enum": ["aws", "gcp"] }, "region": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" }, "account_scope": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" }, "resource_scope": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,63}$" } } } },
        "observability": { "type": "object", "additionalProperties": false, "required": ["metrics", "logs", "alarms", "dashboards"], "properties": { "metrics": { "$ref": "#/$defs/status" }, "logs": { "$ref": "#/$defs/status" }, "alarms": { "$ref": "#/$defs/status" }, "dashboards": { "$ref": "#/$defs/status" } } },
        "cleanup": { "type": "object", "additionalProperties": false, "required": ["attempted", "completed", "resource_refs", "verified_at"], "properties": { "attempted": { "const": true }, "completed": { "const": true }, "resource_refs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "maxLength": 256 } }, "verified_at": { "type": "string", "format": "date-time" } } }
      }
    }
  },
  "$defs": { "status": { "type": "object", "additionalProperties": false, "required": ["status", "checked_at"], "properties": { "status": { "enum": ["available", "unavailable", "not_checked"] }, "checked_at": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "maxLength": 512 } } } }
}
