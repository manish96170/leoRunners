{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leo-runners.dev/schemas/validation-evidence.v1.json",
  "title": "Leo Runners controlled validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "validation.leorunners.io/v1" },
    "kind": { "const": "ControlledValidationEvidence" },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["run", "lifecycle", "cleanup", "evidence"],
      "properties": {
        "run": {
          "type": "object", "additionalProperties": false,
          "required": ["run_id", "repository", "workflow", "provider", "region", "started_at", "finished_at", "duration_ms"],
          "properties": {
            "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
            "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
            "workflow": { "type": "string", "minLength": 1, "maxLength": 128 },
            "provider": { "enum": ["aws", "gcp"] },
            "region": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
            "started_at": { "type": "string", "format": "date-time" },
            "finished_at": { "type": "string", "format": "date-time" },
            "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 }
          }
        },
        "lifecycle": {
          "type": "array", "minItems": 4, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "status", "observed_at", "duration_ms"],
            "properties": {
              "name": { "enum": ["queued", "provisioning", "ready", "assigned", "running", "completed", "cleanup_started", "cleanup_completed"] },
              "status": { "enum": ["observed", "skipped"] },
              "observed_at": { "type": "string", "format": "date-time" },
              "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 }
            }
          }
        },
        "cleanup": {
          "type": "object", "additionalProperties": false,
          "required": ["attempted", "completed", "resource_refs", "verified_at"],
          "properties": {
            "attempted": { "const": true }, "completed": { "const": true },
            "resource_refs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "maxLength": 256 } },
            "verified_at": { "type": "string", "format": "date-time" }
          }
        },
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["metrics", "logs", "alarms", "dashboards"],
          "properties": {
            "metrics": { "$ref": "#/$defs/referenceList" },
            "logs": { "$ref": "#/$defs/referenceList" },
            "alarms": { "$ref": "#/$defs/referenceList" },
            "dashboards": { "$ref": "#/$defs/referenceList" }
          }
        }
      }
    }
  },
  "$defs": {
    "referenceList": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref", "captured_at"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "captured_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
